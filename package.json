{
  "name": "agentspend-cli",
  "version": "0.1.0",
  "description": "Track and cap AI agent API spend, and sync agent config/state across environments",
  "type": "module",
  "license": "MIT",
  "author": "Manoj Mallick",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/manojmallick/agentops.git"
  },
  "keywords": [
    "cli",
    "ai-agents",
    "cost-tracking",
    "budget",
    "sync"
  ],
  "bin": {
    "agentops": "dist/cli.js"
  },
  "files": [
    "dist/cli.js",
    "dist/cli.d.ts",
    "dist/logic"
  ],
  "scripts": {
    "dev": "tsx watch src/cli.ts",
    "build": "tsc -p tsconfig.json",
    "postbuild": "chmod +x dist/cli.js",
    "start": "node dist/cli.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm build && node --test \"dist/test/*.test.js\"",
    "changeset": "changeset",
    "stats:refresh": "node scripts/refresh-stats.mjs && node scripts/generate-stats-banner.mjs",
    "version:sync": "node scripts/sync-versions.mjs",
    "map:refresh": "sigmap",
    "map:report": "sigmap --report --json",
    "map:watch": "sigmap daemon start",
    "map:setup": "sigmap --setup"
  },
  "dependencies": {
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "sigmap": "^8.18.0"
  }
}
